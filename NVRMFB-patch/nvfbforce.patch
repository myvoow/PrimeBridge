+    unsigned st = NVRM_SS_OFF;
+    static SInt32 gIopCeKeeps;
+    auto keep = [&](const char *why) {
+        if (OSIncrementAtomic(&gIopCeKeeps) < 32) ALOG("iop: the copy engine did not take surface 0x%x (%s, status 0x%x)", id, why, st);
+        return !nvAccelSurfCopyReady(s, head) || nvSVPend(id, 2);
+    };
+    struct NVRMRmHandles h; nvSVZero(&h, sizeof h);
+    if (!nvAccelRmHandles(&h)) return keep("no RM handles");
+    bool locked = false;
+    for (unsigned i = 0; i < 8 && !(locked = nvFamLock(a, true)); i++) IOSleep(1);
+    if (!locked) return keep("accelerator lock busy");
+    void *cache = _ZN22IOGraphicsAccelerator223deviceCacheForIOSurfaceEP9IOSurfacej((void *)a, (void *)s, 0);
+    OSObject *ctx = cache ? *(OSObject *volatile *)((unsigned char *)cache + 0x20) : nullptr;
+    NVResource *res = OSDynamicCast(NVResource, ctx);
+    volatile unsigned short *valid = res ? *(unsigned short *volatile *)((volatile unsigned char *)res + 0x30) : nullptr;
+    NVVidMemory *vm = res ? nvres_vidmem(res) : nullptr;
+    const unsigned long long len = (unsigned long long)q.pitch * q.height, pages = (len + 4095) >> 12;
+    bool ok = false;
+    if (valid && !(valid[0] & 1u) && nvAccelResPluginWrote(res) && vm && vm->fRmHandle && !vm->fScanout && vm->fBytes >= len) {
+        unsigned long long *pa = (unsigned long long *)IOMalloc(pages * sizeof *pa);
+        IOService *nvrm = nvAccelNVRM();
+        const OSSymbol *sym = OSSymbol::withCStringNoCopy(NVRM_SS_FN_PAGEOFF);
+        if (pa && nvrm && sym) {
+            for (unsigned long long k = 0; k < pages; k++) pa[k] = q.size + k * 4096;
+            struct NVRMSurfPageoff p; nvSVZero(&p, sizeof p);
+            p.version = NVRM_SS_RM_VERSION; p.status = NVRM_SS_OFF; p.kapiDevice = h.kapiDevice; p.kapiMemory = vm->fRmHandle;
+            p.pages = pa; p.pageCount = pages; p.length = len;
+            nvAccelIopHome(fb, head);
+            nvrm->callPlatformFunction(sym, false, &p, nullptr, nullptr, nullptr);
+            st = p.status;
+            ok = st == 0;
+        }
+        if (sym) sym->release();
+        if (pa) IOFree(pa, pages * sizeof *pa);
+    }
+    if (cache) ((OSObject *)cache)->release();
+    nvFamUnlock(a);
+    if (!ok) return keep("not copied");
+    OSAddAtomic64(1, &gCntIopSrcSurf); OSAddAtomic64(1, &gCntIopOk); OSAddAtomic64(1, &gCntIopOkHead[head]);
+    static SInt32 gIopCeLogs;
+    if (gIopCeLogs < 3) {
+        OSIncrementAtomic(&gIopCeLogs);
+        ALOG("iop: %ux%u frame to the panel by the copy engine, phys 0x%llx, %llu B", q.width, q.height, q.size, len);
+    }
+    return true;
+}
