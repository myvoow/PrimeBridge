+static bool nvAccelIopToPanel(NVAccel *a, IOService *fb, unsigned head, IOSurface *s)
+{
+    struct NVRMVramRequest q;
+    nvSVZero(&q, sizeof q);
+    q.version = NVRM_VRAM_ABI_VERSION;
+    if (a->askFramebufferForScanout(&q, fb) != kIOReturnSuccess || !(q.flags & NVRM_SCANOUT_FLAG_SYSPHYS) || !q.size) return false;
